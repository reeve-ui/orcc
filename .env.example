APP_NAME="ORCC4CHURCH"
# Versi utama dibaca dari file VERSION; APP_VERSION hanya cadangan.
APP_VERSION=1.1.0
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

# Pembaruan aplikasi dari GitHub (tombol di Pengaturan Gereja)
APP_UPDATE_ENABLED=true
APP_UPDATE_REPOSITORY=reeve-ui/orcc
APP_UPDATE_BRANCH=main
APP_UPDATE_BUILD_ASSETS=true
APP_UPDATE_TIMEOUT=900
# APP_UPDATE_PHP_BINARY=/usr/bin/php
# APP_UPDATE_GIT_BINARY=git
# APP_UPDATE_COMPOSER_BINARY=composer
# APP_UPDATE_NPM_BINARY=npm

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Gunakan mysql untuk produksi. sqlite cocok untuk mencoba dengan cepat.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sekretariat_gereja
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Identitas gereja (dipakai pada UI dan kartu KKJ)
# Nilai CHURCH_* dipakai sebagai nilai awal saat migrasi.
# Setelah aplikasi berjalan, ubah identitas dan logo lewat menu Pengaturan Gereja.
CHURCH_CODE=SEKRT
CHURCH_NAME="Sekretariat Gereja"
CHURCH_TAGLINE="Data Jemaat"
CHURCH_ADDRESS="Alamat gereja"
CHURCH_PHONE=""
CHURCH_EMAIL="sekretariat@example.com"
CHURCH_CARD_NOTE="Kartu ini diterbitkan oleh Sekretariat Gereja. Mohon simpan dengan baik."
CHURCH_CARD_SIGNATURE_NAME=""
CHURCH_CARD_SIGNATURE="Sekretariat Gereja"
CHURCH_CARD_VERSION="1.0"

# Akun admin pertama (dipakai oleh seeder)
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@sekretariatgereja.test
ADMIN_PASSWORD=password
